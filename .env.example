# Copia este archivo como .env y rellena (docs/MANUAL.md). Nunca lo subas a git.
META_APP_ID=
META_APP_SECRET=
# Token corto del Explorador de la Graph API (se borra solo tras npm run ig:setup)
META_SHORT_TOKEN=
# Opcional: usuario de Instagram a publicar (por defecto iaenapuros)
IG_USERNAME=iaenapuros
# Los rellena npm run ig:setup:
META_USER_TOKEN=
META_PAGE_ID=
META_PAGE_TOKEN=
IG_USER_ID=

# --- Publicación en Instagram + TikTok vía PostEverywhere (vía por defecto, docs/MANUAL.md paso 0) ---
# Clave en app.posteverywhere.ai/developers
POSTEVERYWHERE_API_KEY=
# Opcional: ids de cuentas separados por comas (por defecto, la primera cuenta sana de cada plataforma)
POSTEVERYWHERE_ACCOUNT_IDS=
